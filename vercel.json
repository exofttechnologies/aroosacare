{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/product",
      "destination": "/products/aroosa-baby-wipes",
      "permanent": true
    },
    {
      "source": "/product/",
      "destination": "/products/aroosa-baby-wipes",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/products/aroosa-baby-wipes",
      "destination": "/products/aroosa-baby-wipes/index.html"
    },
    {
      "source": "/((?!assets/|images/|products/|product/|favicon|robots\\.txt|sitemap\\.xml|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
